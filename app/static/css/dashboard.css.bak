/* ======================================================
   SGF ENTERPRISE · DASHBOARD V2
====================================================== */

.dashboard{
    display:flex;
    flex-direction:column;
    gap:18px;
}

.pageHeader{
    display:flex;
    justify-content:space-between;
    gap:20px;
    align-items:flex-start;
    margin-bottom:6px;
}

.pageHeader h1{
    margin:0;
    font-size:34px;
    color:#173D2D;
}

.pageHeader p{
    margin:6px 0 0;
    color:#6b7a72;
}

.headerActions{
    display:flex;
    gap:12px;
    align-items:center;
}

.infoBox,
.kpiCard,
.panel{
    background:#fff;
    border-radius:22px;
    box-shadow:0 8px 25px rgba(0,0,0,.06);
}

.infoBox{
    padding:12px 16px;
    min-width:145px;
}

.infoBox strong{
    display:block;
}

.infoBox span{
    font-size:12px;
    color:#7d8b83;
}

.primaryButton{
    border:0;
    background:#173D2D;
    color:#fff;
    border-radius:16px;
    padding:14px 18px;
    font-weight:800;
    cursor:pointer;
}

.primaryButton:hover{
    background:#255340;
}


/* KPIs */

.kpiGrid{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:16px;
}

.kpiCard{
    padding:20px;
}

.kpiCard span{
    display:block;
    color:#6b7a72;
    font-size:13px;
    font-weight:700;
}

.kpiCard h2{
    font-size:36px;
    margin:12px 0 0;
    color:#173D2D;
}

.kpiCard.danger h2{
    color:#d84b3f;
}

.kpiCard.danger {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.kpiCard.danger:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(216, 75, 63, 0.12);
}


/* Grids */

.dashboardGrid{
    display:grid;
    gap:18px;
}

.dashboardGrid.dashboardTop{
    grid-template-columns:1.5fr 1fr 1fr;
}

.dashboardGrid.three{
    grid-template-columns:1.2fr 1.2fr 1fr;
}

.dashboardGrid.two{
    grid-template-columns:2fr 1fr;
}

.panel{
    padding:20px;
    min-height:190px;
}

.panel h2{
    font-size:17px;
    margin:0 0 14px;
    color:#173D2D;
}

.panel.wide{
    min-height:250px;
}

.panelLarge{
    min-height:310px;
}

.empty{
    border:2px dashed #dbe5df;
    background:#fbfdfc;
    color:#8a9b91;
    border-radius:16px;
    padding:22px;
    text-align:center;
}


/* Header interno */

.dashboardSectionHeader{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    margin-bottom:15px;
}

.dashboardSectionHeader strong{
    font-size:18px;
}

.dashboardSectionHeader span{
    display:block;
    color:#7c8b84;
    font-size:13px;
}


/* Filtros */

.filterTabs{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

.filterTab{
    border:none;
    padding:7px 14px;
    border-radius:30px;
    background:#edf4ef;
    cursor:pointer;
    font-size:12px;
    font-weight:700;
}

.filterTab.active,
.filterTab:hover{
    background:#173D2D;
    color:white;
}


/* Tarjetas incorporación */

.compactList{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.incorporacionCard{
    border:1px solid #edf2ee;
    border-radius:16px;
    padding:14px;
    cursor:pointer;
    transition:.25s;
}

.incorporacionCard:hover{
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(0,0,0,.08);
}

.incorporacionTop{
    display:flex;
    justify-content:space-between;
    gap:15px;
}

.incorporacionTop strong{
    display:block;
    font-size:15px;
}

.incorporacionTop span{
    color:#718178;
    font-size:12px;
}

.incorporacionTop em{
    color:#167a49;
    font-style:normal;
    font-size:12px;
    font-weight:700;
}

.progressLine{
    width:100%;
    height:9px;
    background:#edf2ee;
    border-radius:30px;
    margin-top:12px;
    overflow:hidden;
}

.progressFill{
    height:100%;
    background:#2fc46c;
    border-radius:30px;
}

.incorporacionStatus{
    display:flex;
    justify-content:space-between;
    margin-top:8px;
    font-size:13px;
}

.incorporacionStatus strong{
    color:#167a49;
}


/* Listas */

.listItem{
    display:flex;
    justify-content:space-between;
    gap:12px;
    padding:12px 0;
    border-bottom:1px solid #edf2ee;
}

.listItem strong{
    display:block;
    font-size:14px;
}

.listItem span{
    font-size:12px;
    color:#6b7a72;
}

.listItem em{
    font-style:normal;
    color:#167a49;
    font-weight:800;
    font-size:12px;
}

.stateRow{
    display:flex;
    justify-content:space-between;
    padding:11px 0;
    border-bottom:1px solid #edf2ee;
}

.stateRow span{
    color:#25362e;
}

.stateRow strong{
    color:#173D2D;
}

.clickable{
    cursor:pointer;
}

.clickable:hover{
    background:#f5faf7;
}

.dayCard{
    border-bottom:1px solid #edf2ee;
    padding-bottom:12px;
    margin-bottom:12px;
}

.dayHeader{
    display:flex;
    justify-content:space-between;
    margin-bottom:8px;
}

.dayHeader strong{
    color:#173D2D;
}

.dayHeader span{
    color:#7a8a82;
}

.miniPersona{
    padding:4px 0;
    font-size:13px;
    cursor:pointer;
}

.miniPersona:hover{
    color:#167a49;
    font-weight:700;
}


/* Métricas */

.metricBig{
    font-size:46px;
    font-weight:900;
    color:#167a49;
}

.dangerText{
    color:#d84b3f;
}

.muted{
    color:#6b7a72;
}

.fakeChart{
    height:110px;
    display:flex;
    gap:10px;
    align-items:flex-end;
    margin-top:18px;
}

.fakeChart span{
    flex:1;
    background:#2fc46c;
    border-radius:10px 10px 0 0;
}

.dangerChart span{
    background:#d84b3f;
}

.badge{
    padding:5px 9px;
    border-radius:999px;
    background:#edf2ee;
}

.dangerBadge{
    background:#ffe8e5;
    color:#d84b3f;
}


/* Accesos rápidos */

.quickActions{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.quickActions button{
    border:0;
    background:#e8f5ee;
    color:#173D2D;
    padding:13px;
    border-radius:14px;
    font-weight:800;
    text-align:left;
    cursor:pointer;
}

.quickActions button:hover{
    background:#d8ede2;
}


/* Responsive */

@media(max-width:1450px){
    .kpiGrid{
        grid-template-columns:repeat(3,1fr);
    }

    .dashboardGrid.dashboardTop,
    .dashboardGrid.three,
    .dashboardGrid.two{
        grid-template-columns:1fr;
    }
}

@media(max-width:900px){
    .pageHeader{
        flex-direction:column;
    }

    .headerActions{
        flex-direction:column;
        align-items:flex-start;
    }

    .kpiGrid{
        grid-template-columns:1fr;
    }
}


/* ======================================================
   ALERTAS DE IMPUNTUALIDAD (MODAL & BANNER DE RETRASOS)
====================================================== */
.tardiness-banner {
    background: #fffdf5;
    border: 1px solid #ffd000;
    border-radius: 16px;
    padding: 16px 24px;
    margin-bottom: 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(255, 208, 0, 0.12);
    transition: transform 0.2s, box-shadow 0.2s;
}
.tardiness-banner:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(255, 208, 0, 0.22);
}
.tardiness-banner-content {
    display: flex;
    align-items: center;
    gap: 15px;
    color: #856404;
    font-size: 0.95em;
    font-weight: 600;
}
.tardiness-banner-icon {
    font-size: 1.8em;
}
.tardiness-banner-action {
    font-weight: 800;
    font-size: 0.8em;
    text-transform: uppercase;
    color: #856404;
    background: #fff3cd;
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid #ffeeba;
    letter-spacing: 0.5px;
}

/* Modal */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(5px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    animation: fadeIn 0.2s ease-out;
}
.modal-content {
    background: white;
    border-radius: 20px;
    width: 90%;
    max-width: 650px;
    max-height: 80vh;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.modal-header {
    padding: 20px 25px;
    border-bottom: 1px solid #edf2f7;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fafafb;
}
.modal-header h2 {
    margin: 0;
    font-size: 1.2em;
    color: #1a202c;
    display: flex;
    align-items: center;
    gap: 10px;
}
.btn-close {
    background: none;
    border: none;
    font-size: 1.5em;
    color: #a0aec0;
    cursor: pointer;
    transition: color 0.2s, transform 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
}
.btn-close:hover {
    color: #e53e3e;
    background: #fff5f5;
    transform: rotate(90deg);
}
.modal-body {
    padding: 25px;
    overflow-y: auto;
    background: #f7fafc;
}
.late-worker-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 18px;
    margin-bottom: 20px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
}
.late-worker-card:last-child {
    margin-bottom: 0;
}
.late-worker-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    border-bottom: 1px solid #edf2f7;
    padding-bottom: 10px;
}
.late-worker-name {
    font-weight: 700;
    font-size: 1.05em;
    color: #2d3748;
}
.late-worker-badge {
    background: #fff5f5;
    color: #c53030;
    font-weight: 800;
    font-size: 0.78em;
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid #fed7d7;
    letter-spacing: 0.5px;
}
.late-days-list {
    font-size: 0.88em;
    color: #4a5568;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.late-day-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    padding: 10px 16px;
    border-radius: 10px;
    border: 1px solid #edf2f7;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}
@keyframes slideUp {
    from { transform: translateY(24px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
